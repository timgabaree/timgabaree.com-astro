---
import sites from '../data/family-sites.json';
---
<div class="family-sites">
 <p id="family-sites-label">Part of the Gabaree family of websites</p>
 <nav aria-labelledby="family-sites-label">
  <ul>
   {sites.map((site,index)=><li>{index>0&&<span class="family-site-separator" aria-hidden="true">·</span>}<a href={site.url} target="_blank" rel="noopener noreferrer">{site.label}<span class="family-site-announcement"> (opens in a new tab)</span></a></li>)}
  </ul>
 </nav>
</div>
<style>
 .family-sites{max-width:1000px;margin:1.5rem auto 0;padding:1rem .5rem 0;border-top:1px solid var(--border-color);color:var(--text-muted);text-align:center;line-height:1.6}
 .family-sites p{font-size:.85rem;margin:0}
 .family-sites ul{display:flex;flex-wrap:wrap;justify-content:center;gap:0;list-style:none;padding:0;margin:-.2rem 0 0}
 .family-sites li{display:inline-flex;align-items:center;margin:0;padding:0}
 .family-sites a{display:inline-flex;align-items:center;min-height:44px;font-size:.82rem;color:var(--brand-blue);text-decoration:none}
 .family-sites a:visited{color:var(--brand-blue)}
 .family-sites a:hover{text-decoration:underline;text-underline-offset:.2em;transform:none}
 .family-sites a:focus-visible{outline:2px solid currentColor;outline-offset:3px}
 .family-site-separator{padding:0 .65rem;color:var(--text-muted)}
 .family-site-announcement{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 @media(max-width:640px){.family-sites a{min-height:0;line-height:inherit}}
</style>
