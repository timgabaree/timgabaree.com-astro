---
interface Props {
  page: string;
}

const { page } = Astro.props;
const isHome = page === 'home';
const homePrefix = isHome ? '' : '/';
---

<nav class="navbar" aria-label="Primary navigation">
  <button
    class="navbar-toggler"
    type="button"
    aria-controls="navbarNav"
    aria-expanded="false"
    aria-label="Open navigation menu"
  >
    <span class="navbar-toggler-icon" aria-hidden="true"></span>
  </button>

  <a class="navbar-brand" href={isHome ? '#home' : '/#home'}>Tim Gabaree</a>

  <div class="navbar-collapse" id="navbarNav">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a
          class="nav-link"
          href={isHome ? '#home' : '/#home'}
          aria-current={isHome ? 'page' : undefined}
        >
          Home
        </a>
      </li>

      <li class="nav-item dropdown">
        <button
          class="nav-link dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="operating-leadership-menu"
          aria-haspopup="true"
        >
          Operating Leadership
        </button>

        <div class="dropdown-menu" id="operating-leadership-menu">
          <a
            class="dropdown-item"
            href="/technology-leadership"
            aria-current={page === 'technology-leadership' ? 'page' : undefined}
          >
            Technology Leadership
          </a>
          <a
            class="dropdown-item"
            href="/value-creation"
            aria-current={page === 'value-creation' ? 'page' : undefined}
          >
            Technology Value Creation
          </a>
          <a
            class="dropdown-item"
            href="/governance"
            aria-current={page === 'governance' ? 'page' : undefined}
          >
            Technology Governance
          </a>
          <a class="dropdown-item" href={`${homePrefix}#operating-results`}>
            Operating Results
          </a>
          <a class="dropdown-item" href={`${homePrefix}#board`}>
            Board and Advisory
          </a>
          <a class="dropdown-item" href={`${homePrefix}#results`}>
            Strategic Impact
          </a>
          <a class="dropdown-item" href={`${homePrefix}#expertise`}>
            Expertise
          </a>
          <a class="dropdown-item" href={`${homePrefix}#education`}>
            Education
          </a>
        </div>
      </li>

      <li class="nav-item dropdown">
        <button
          class="nav-link dropdown-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="about-menu"
          aria-haspopup="true"
        >
          About
        </button>

        <div class="dropdown-menu" id="about-menu">
          <a
            class="dropdown-item"
            href="/about"
            aria-current={page === 'about' ? 'page' : undefined}
          >
            About Tim
          </a>
          <a class="dropdown-item" href={`${homePrefix}#q-and-a`}>
            Leadership Perspective
          </a>
          <a class="dropdown-item" href={`${homePrefix}#testimonials`}>
            Testimonials
          </a>
        </div>
      </li>

      <li class="nav-item">
        <a
          class="nav-link"
          href="/contact"
          aria-current={page === 'contact' ? 'page' : undefined}
        >
          Connect
        </a>
      </li>
    </ul>
  </div>

  <div class="nav-link-container" aria-label="Tim Gabaree social profiles">
    <a
      class="nav-link"
      href="https://timgabaree.blogspot.com"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit Tim Gabaree’s blog — opens in a new tab"
    >
      <img
        src="/media/social-media-blogger-icon-50x50.webp"
        alt=""
        width="25"
        height="25"
        loading="lazy"
        aria-hidden="true"
      />
    </a>
    <a
      class="nav-link"
      href="https://www.linkedin.com/in/timgabaree"
      target="_blank"
      rel="me noopener noreferrer"
      aria-label="Visit Tim Gabaree’s LinkedIn profile — opens in a new tab"
    >
      <img
        src="/media/social-media-linkedin-icon-50x50.webp"
        alt=""
        width="25"
        height="25"
        loading="lazy"
        aria-hidden="true"
      />
    </a>
    <a
      class="nav-link"
      href="https://github.com/timgabaree"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visit Tim Gabaree’s GitHub profile — opens in a new tab"
    >
      <img
        src="/media/social-media-github-icon-50x50.webp"
        alt=""
        width="25"
        height="25"
        loading="lazy"
        aria-hidden="true"
      />
    </a>
  </div>
</nav>
