---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import AnalyticsChoices from '../components/AnalyticsChoices.astro';
import pageMetadata from '../data/page-meta.json';

interface Props {
  page: string;
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: string;
  image?: string;
  imageAlt?: string;
  preloadImage?: string;
  structuredData?: object;
  scripts?: string[];
  robots?: string;
}

const {
  page,
  title,
  description,
  canonicalPath,
  ogType = 'website',
  image = '/media/profile-pic-tim-gabaree-900x1200.webp',
  imageAlt = 'Portrait of Tim Gabaree',
  preloadImage,
  structuredData,
  scripts = [],
  robots,
} = Astro.props;

const meta = pageMetadata[page as keyof typeof pageMetadata];
const isStaging = import.meta.env.PUBLIC_SITE_ENV !== 'production';
const enableAnalytics = import.meta.env.PROD && !isStaging;
const siteUrl = 'https://timgabaree.com';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111111" />
    <title>{title}</title>
    <meta name="author" content="Tim Gabaree" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={isStaging ? 'noindex, nofollow, noarchive' : (robots ?? meta?.robots)}
    />
    {page !== '404' && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Tim Gabaree" />
    <meta property="og:title" content={meta?.ogTitle ?? title} />
    <meta property="og:description" content={meta?.ogDescription ?? description} />
    {page !== '404' && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={meta?.imageWidth?.toString()} />
    <meta property="og:image:height" content={meta?.imageHeight?.toString()} />
    {ogType === 'profile' && <>
      <meta property="profile:first_name" content="Tim" />
      <meta property="profile:last_name" content="Gabaree" />
    </>}

    <meta name="twitter:card" content={meta?.twitterCard ?? 'summary'} />
    <meta name="twitter:title" content={meta?.ogTitle ?? title} />
    <meta name="twitter:description" content={meta?.twitterDescription ?? description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/Roboto-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Roboto-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {(preloadImage || meta?.preloadImage) && <link rel="preload" as="image" href={preloadImage || meta?.preloadImage} fetchpriority="high" />}
    <link rel="stylesheet" href="/css/style.css" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    )}

    <script is:inline src="/js/analytics.js" defer></script>
  </head>
  <body class={meta?.bodyClass || undefined}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navigation page={page} />
    <slot />
    <AnalyticsChoices enableAnalytics={enableAnalytics} />
    <Footer page={page} />

    <script is:inline src="/js/main.js" defer></script>
    {scripts.map((script) => <script is:inline src={script} defer></script>)}
  </body>
</html>
