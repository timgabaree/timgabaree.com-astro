---
import BaseLayout from '../layouts/BaseLayout.astro';
import sitemapXml from '../../public/sitemap.xml?raw';

// Render at build time from the search-engine sitemap: no browser XSLT or JS.
const labels: Record<string, string> = {
  '/': 'Home',
  '/technology-leadership': 'Technology Leadership',
  '/value-creation': 'Business Results from Technology',
  '/governance': 'Governance',
  '/about': 'About',
  '/contact': 'Contact',
  '/privacy': 'Privacy Policy',
  '/sitemap': 'Sitemap',
};
const pages = Array.from(sitemapXml.matchAll(/<url>([\s\S]*?)<\/url>/g), ([, entry]) => {
  const location = entry.match(/<loc>([^<]+)<\/loc>/)?.[1];
  if (!location) throw new Error('Sitemap entry is missing its URL');
  const url = new URL(location);
  if (url.origin !== 'https://timgabaree.com' || !labels[url.pathname]) {
    throw new Error(`Add a sitemap label for ${location}`);
  }
  const images = Array.from(entry.matchAll(/<image:loc>([^<]+)<\/image:loc>/g), ([, source]) => {
    const imageUrl = new URL(source);
    if (imageUrl.origin !== url.origin || !imageUrl.pathname.startsWith('/media/')) {
      throw new Error(`Unexpected sitemap image: ${source}`);
    }
    const filename = imageUrl.pathname.split('/').pop()!;
    const dimensions = filename.match(/(\d+)x(\d+)\.[^.]+$/);
    const title = filename.replace(/\.[^.]+$/, '').replace(/-?\d+x\d+$/, '').replace(/[-_]/g, ' ');
    return { href: imageUrl.pathname, filename, title: title[0].toUpperCase() + title.slice(1),
      width: dimensions ? Number(dimensions[1]) : undefined,
      height: dimensions ? Number(dimensions[2]) : undefined };
  });
  return { href: url.pathname, label: labels[url.pathname], images };
});
const imageCount = pages.reduce((count, page) => count + page.images.length, 0);
---

<BaseLayout page="sitemap" title="Sitemap | Tim Gabaree"
  description="Explore the public pages and indexed images on Tim Gabaree’s website."
  canonicalPath="/sitemap" robots="index, follow">
  <main id="main-content" class="sitemap-page">
    <section class="sitemap-card" aria-labelledby="sitemap-title">
      <p class="eyebrow">EXPLORE THE WEBSITE</p>
      <h1 id="sitemap-title">Sitemap</h1>
      <p>Find information about my work, leadership experience, and ways to connect.</p>
      <p><a href="#sitemap-media">Browse pictures and media ({imageCount} page-image entries)</a></p>
      <nav aria-label="All website pages">
        <ul>
          {pages.map(({ href, label }) => <li><a href={href}>{label}<span aria-hidden="true"> →</span></a></li>)}
        </ul>
      </nav>
      <section id="sitemap-media" aria-labelledby="sitemap-media-title">
        <h2 id="sitemap-media-title">Pictures and media</h2>
        <p>Images listed in the search-engine sitemap, grouped by the pages they accompany. Select a thumbnail to open the full-size image. Images used on several pages appear in each relevant group.</p>
        {pages.filter(page => page.images.length > 0).map(page => (
          <section class="media-group" data-sitemap-page={page.href} aria-label={`${page.label} images`}>
            <h3><a href={page.href}>{page.label}</a> <span>({page.images.length} {page.images.length === 1 ? 'image' : 'images'})</span></h3>
            <ul class="image-grid">
              {page.images.map(image => (
                <li>
                  <a class="image-card" href={image.href}>
                    <img src={image.href} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" />
                    <span class="image-title">{image.title}</span>
                    <small>{image.filename}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
      <p class="xml-link">For search engines: <a href="/sitemap.xml">XML sitemap</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .sitemap-page { padding: 48px 20px; min-height: 60vh; }
  .sitemap-card { max-width: 880px; margin: 0 auto; padding: 36px; border-radius: 16px; background: #fff; color: #17243a; box-shadow: 0 8px 32px rgb(0 0 0 / 12%); }
  .eyebrow { font-size: .8rem; font-weight: 700; letter-spacing: .14em; color: #415a77; }
  h1 { margin: 12px 0 16px; font-size: clamp(2rem, 6vw, 3rem); }
  p { line-height: 1.6; }
  ul { list-style: none; padding: 0; margin: 28px 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  nav li a { display: flex; justify-content: space-between; gap: 12px; min-height: 48px; align-items: center; padding: 16px; background: #f0f4f8; border-radius: 8px; text-decoration: none; }
  a { color: #174d83; }
  a:hover { text-decoration: underline; }
  a:focus-visible { outline: 3px solid #174d83; outline-offset: 4px; }
  .xml-link { padding-top: 20px; border-top: 1px solid #d9e1ea; font-size: .9rem; }
  #sitemap-media { padding-top: 24px; border-top: 1px solid #d9e1ea; scroll-margin-top: 80px; }
  h2 { font-size: 1.75rem; }
  h3 { margin: 28px 0 12px; font-size: 1.2rem; }
  h3 span { font-size: .9rem; font-weight: 400; }
  .image-grid { margin: 16px 0 32px; }
  .image-grid li { min-width: 0; }
  .image-card { display: flex; flex-direction: column; height: 100%; padding: 12px; gap: 10px; border: 1px solid #d9e1ea; border-radius: 8px; text-decoration: none; }
  .image-card img { display: block; width: 100%; height: 180px; object-fit: contain; background: #f0f4f8; border-radius: 4px; }
  .image-title { font-weight: 700; overflow-wrap: anywhere; }
  .image-card small { color: #415a77; overflow-wrap: anywhere; line-height: 1.5; }
  @media (max-width: 600px) { .sitemap-page { padding: 24px 12px; } .sitemap-card { padding: 24px 20px; } ul { grid-template-columns: 1fr; } }
</style>
