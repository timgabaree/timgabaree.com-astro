---
import BaseLayout from '../layouts/BaseLayout.astro';
const isStaging = import.meta.env.PUBLIC_SITE_ENV !== 'production';

const structuredData = {"@context":"https://schema.org","@graph":[{"@type":"WebSite","@id":"https://timgabaree.com/#website","url":"https://timgabaree.com/","name":"Tim Gabaree","description":"CIO and technology executive focused on AI strategy and enablement, cybersecurity, enterprise technology, infrastructure and operations, and technology value creation.","inLanguage":"en-US"},{"@type":"WebPage","@id":"https://timgabaree.com/privacy#webpage","url":"https://timgabaree.com/privacy","name":"Privacy Policy | Tim Gabaree","description":"Privacy Policy for timgabaree.com explaining what information may be collected, how it is used, and the privacy choices available to website visitors.","inLanguage":"en-US","datePublished":"2026-08-07T00:00:00-05:00","dateModified":"2026-08-20T00:00:00-05:00","isPartOf":{"@id":"https://timgabaree.com/#website"},"about":{"@id":"https://timgabaree.com/#person"}},{"@type":"Person","@id":"https://timgabaree.com/#person","name":"Tim Gabaree","givenName":"Tim","familyName":"Gabaree","url":"https://timgabaree.com/","image":{"@id":"https://timgabaree.com/#primaryimage"},"jobTitle":"CIO and Technology Executive","description":"CIO and technology executive focused on AI strategy and enablement, cybersecurity, enterprise technology, infrastructure and operations, and technology value creation.","email":"mailto:tim@timgabaree.com","telephone":"+1-571-762-3769","sameAs":["https://www.linkedin.com/in/timgabaree","https://github.com/timgabaree","https://timgabaree.blogspot.com","https://x.com/timgabaree","https://bsky.app/profile/timgabaree.bsky.social"],"spouse":{"@type":"Person","@id":"https://carriegabaree.com/#person","name":"Carrie Gabaree","url":"https://carriegabaree.com/","sameAs":["https://www.linkedin.com/in/carriegabaree"]},"affiliation":{"@type":"Organization","name":"RGE Solutions LLC","url":"https://rgesol.com/"},"memberOf":[{"@type":"Organization","name":"Private Directors Association"},{"@type":"Organization","name":"IEEE"},{"@type":"Organization","name":"ISC2"},{"@type":"Organization","name":"Project Management Institute"}],"alumniOf":[{"@type":"CollegeOrUniversity","name":"Purdue University Global"},{"@type":"CollegeOrUniversity","name":"University of Illinois Springfield"}],"hasCredential":[{"@type":"EducationalOccupationalCredential","name":"Master of Business Administration"},{"@type":"EducationalOccupationalCredential","name":"Certified Information Systems Security Professional"},{"@type":"EducationalOccupationalCredential","name":"Project Management Professional"},{"@type":"EducationalOccupationalCredential","name":"Wharton Corporate Governance Certificate"}],"knowsAbout":["AI Strategy and Enablement","Artificial Intelligence","Cybersecurity","Enterprise Technology","Infrastructure and Operations","Technology Value Creation","Enterprise Performance","Technology Strategy","Technology Investment","Technology Modernization","Enterprise Architecture","Cloud Computing","Vendor Rationalization","Post-Acquisition Integration","Program Recovery","Operating Model Improvement","Digital Transformation"],"knowsLanguage":["en"]}]};
---

<BaseLayout
  page="privacy"
  title="Privacy Policy | Tim Gabaree"
  description="Privacy Policy for timgabaree.com explaining what information may be collected, how it is used, and the privacy choices available to website visitors."
  canonicalPath="/privacy"
  ogType="website"
  image="/media/profile-pic-tim-gabaree-900x1200.webp"
  imageAlt="Portrait of Tim"
  preloadImage={undefined}
  structuredData={{ ...structuredData, '@graph': structuredData['@graph'].map((entry) =>
    entry['@type'] === 'WebPage' ? { ...entry, dateModified: '2026-10-27T00:00:00-05:00' } : entry) }}
  scripts={[]}
>
<main
    id="main-content"
    class="privacy-page">

    <img src="/media/background-pic-architecture-1920x942.webp" alt="" width="1920" height="942" class="page-background-image" loading="eager" fetchpriority="high" decoding="async">
    <div class="privacy-container">

<!-- Privacy Policy Introduction -->

        <section
            class="privacy-card privacy-intro"
            aria-labelledby="privacy-title">

            <p class="privacy-eyebrow">
                Privacy &amp; Data Use
            </p>

            <h1 id="privacy-title">
                Privacy Policy
            </h1>

            {isStaging && <aside aria-label="Staging privacy notice">
                <h2>Staging site notice</h2>
                <p>This password-protected test site runs on Cloudflare, separately
                from the live PHP website. Analytics are disabled. When email is
                enabled, contact details and messages pass through Cloudflare and
                Resend to Tim Gabaree’s mailbox. Resend and the receiving email
                service may retain messages and delivery records. Email open and
                click tracking are not configured. Please use test information only.</p>
                <p>The site’s contact handler does not persist message bodies.
                It keeps short-lived security tokens and rate-limit state. The
                policy below describes the prepared Cloudflare site, not the
                separate PHP site still hosted at GoDaddy.</p>
            </aside>}

            <p class="privacy-updated">
                Last Updated:
                <time datetime="2026-10-27T00:00:00-05:00">
                    October 27, 2026                </time>
            </p>

            <p>
        At timgabaree.com, your privacy is important. This Privacy
        Policy explains what information may be collected when you
        visit this website, how it is used, and the choices available
        to you.
      </p>

      <p>
        This website is intended to provide information about Tim
        Gabaree’s professional experience, leadership philosophy,
        consulting services, and board advisory work. Any personal
        information submitted through this website is used solely for
        responding to inquiries and maintaining professional
        communications.
      </p>

      <p>
        This Privacy Policy describes the information practices associated
        with this website and the services available through it.
      </p>

    </section>

<!-- End Privacy Policy Introduction -->

<!-- Privacy Policy Contents -->

    <section
      id="privacy-contents"
      class="privacy-card privacy-contents"
      aria-labelledby="privacy-contents-title">

      <h2 id="privacy-contents-title">
        Contents
      </h2>

      <nav aria-label="Privacy Policy contents">

        <ol class="privacy-contents-list">

          <li>
            <a href="#information-collected-title">
              Information We Collect
            </a>
          </li>

          <li>
            <a href="#cookies-title">
              Cookies
            </a>
          </li>

          <li>
            <a href="#information-use-title">
              How Your Information Is Used
            </a>
          </li>

          <li>
            <a href="#third-party-title">
              Third-Party Services
            </a>
          </li>

          <li>
            <a href="#retention-title">
              Data Retention
            </a>
          </li>

          <li>
            <a href="#security-title">
              Data Security
            </a>
          </li>

          <li>
            <a href="#rights-title">
              Your Rights
            </a>
          </li>

          <li>
            <a href="#external-links-title">
              External Links
            </a>
          </li>

          <li>
            <a href="#changes-title">
              Changes to This Privacy Policy
            </a>
          </li>

          <li>
            <a href="#privacy-contact-title">
              Contact
            </a>
          </li>

        </ol>

      </nav>

    </section>

<!-- End Privacy Policy Contents -->

<!-- Information We Collect -->

    <section
      class="privacy-card"
      aria-labelledby="information-collected-title">

      <h2 id="information-collected-title">
        Information We Collect
      </h2>

      <h3>
        Information You Provide
      </h3>

      <p>
        If you choose to contact us through the website, we may collect
        information that you voluntarily provide, including:
      </p>

      <ul>
        <li>Name</li>
        <li>Email address</li>
        <li>Company, if provided</li>
        <li>Phone number, if provided</li>
        <li>Any information included in your message</li>
      </ul>

      <p>
        This information is used solely to respond to your inquiry or
        provide requested information.
      </p>

      <h3>
        Automatically Collected Information
      </h3>

      <p>
        Certain technical information is processed automatically when you
        visit or interact with the site. Depending on the feature used,
        this may include:
      </p>

      <ul>
        <li>IP address</li>
        <li>Browser type and version</li>
        <li>Device information</li>
        <li>Pages visited</li>
        <li>Date and time of your visit</li>
        <li>Time spent on pages</li>
        <li>Referring website</li>
        <li>Browser user-agent information</li>
      </ul>

      <p>
        This information may be used for website operation, analytics,
        performance monitoring, usability, and security.
      </p>

      <p>
        Cloudflare processes technical request information to serve and
        protect this website. The contact handler uses a cryptographic
        hash derived from the IP address and recent request timestamps
        to limit abuse. It does not store raw IP addresses or browser
        user-agent information in its form-security state, or include
        them in the inquiry email. Hosting providers may separately
        process technical information under their own policies.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Information We Collect -->

<!-- Cookies -->

    <section
      class="privacy-card"
      aria-labelledby="cookies-title">

      <h2 id="cookies-title">
        Cookies
      </h2>

      <p>
        This website uses a first-party cookie for contact-related
        requests. It supports form security, submission throttling, and
        one-time contact-conversion state. The session cookie is not used
        to create a persistent visitor profile. It expires after one hour
        unless refreshed by another request for a form token. It is
        restricted to secure connections and cannot be read by page scripts.
      </p>

      <p>
        Optional Google Analytics, delivered through Google Tag Manager, is off
        until you select “Allow cookies” in the small cookie notice or in
        “Privacy choices” in the footer. It measures visits and link clicks
        to help improve the website and may use cookies and device information.
        Declining does not prevent you from using the website, contacting me,
        or scheduling a meeting. Dismissing the notice does not grant consent;
        it hides the notice for the current browser tab session. Google Analytics
        is disabled on staging.
      </p>

      <p>
        Your choice is stored in your browser for 180 days (about six months),
        using local storage under “tg-analytics-choice-v1.” This preference is
        used only to remember your decision. Use “Privacy choices” in the
        production website’s footer to change it at any time. If browser storage
        is unavailable, Google Analytics stays off. Without JavaScript, Google
        Analytics does not load. A separate session-storage preference,
        “tg-analytics-dismissed-v1,” remembers when you dismiss the notice.
      </p>

      <p>
        Withdrawing consent stops future Google Analytics collection and removes known
        first-party Google analytics cookies. The page reloads if analytics were
        already running. Withdrawal does not erase information previously sent
        to Google. See <a href="https://business.safety.google/privacy/" target="_blank" rel="noopener noreferrer">how Google uses information from sites that use its services (opens in a new tab)</a>.
      </p>

      <p>
        Cloudflare Web Analytics separately measures basic traffic and page
        performance without analytics cookies or local-storage identifiers.
        It does not track individual visitors across visits and is independent
        of the Google Analytics cookie choice. Cloudflare also processes network
        information for hosting and security, as described above.
        See <a href="https://www.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>.
      </p>

      <p>
        Calendly resources are loaded when the scheduling feature is
        activated. Calendly may use cookies or browser storage as part of
        providing its scheduling service.
      </p>

      <p>
        You can configure your browser to refuse or remove cookies,
        although some website features may not function as intended.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Cookies -->

<!-- How Your Information Is Used -->

    <section
      class="privacy-card"
      aria-labelledby="information-use-title">

      <h2 id="information-use-title">
        How Your Information Is Used
      </h2>

      <p>
        Information collected through this website may be used to:
      </p>

      <ul>
        <li>Respond to inquiries</li>
        <li>Communicate regarding requested information</li>
        <li>Improve website performance</li>
        <li>Monitor website security</li>
        <li>Analyze website usage</li>
        <li>Maintain and improve the visitor experience</li>
      </ul>

      <p>
        <strong>Your information is not sold to third parties.</strong>
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End How Your Information Is Used -->

<!-- Third-Party Services -->

    <section
      class="privacy-card"
      aria-labelledby="third-party-title">

      <h2 id="third-party-title">
        Third-Party Services
      </h2>

      <p>
        This website uses or integrates with third-party services that
        support hosting, measurement, scheduling, security, and related
        website functions. These services include:
      </p>

      <ul>
        <li>Google Tag Manager</li>
        <li>Google Analytics, when configured through site measurement</li>
        <li>Google Search Console</li>
        <li>Calendly</li>
        <li><a href="https://www.cloudflare.com/privacypolicy/">Cloudflare</a> for website hosting, delivery, and security</li>
        <li><a href="https://resend.com/legal/privacy-policy">Resend</a> for contact-form email delivery</li>
      </ul>

      <p>
        Contact information and message content pass through Cloudflare
        and Resend to Tim Gabaree’s email service and mailbox so he can
        respond. Your email address is used as the reply-to address;
        messages are sent only to a fixed site-owner address. Resend
        processes email data in the United States. Email open and click
        tracking are not enabled for contact messages.
      </p>

      <p>
        The website also contains links to external services and
        professional platforms, including LinkedIn and DocSend. Those
        services are governed by their own privacy policies when you
        choose to visit them.
      </p>

      <p>
        Third-party providers maintain their own privacy policies
        governing how they process information.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Third-Party Services -->

<!-- Data Retention -->

    <section
      class="privacy-card"
      aria-labelledby="retention-title">

      <h2 id="retention-title">
        Data Retention
      </h2>

      <p>
        Information submitted through the website is retained only for
        as long as reasonably necessary to respond to inquiries,
        maintain business records, comply with legal obligations, or
        protect the security of the website.
      </p>

      <p>
        The website’s contact handler does not save message bodies in
        its form-security storage. Form tokens and conversion flags expire
        after one hour; submission rate limits use a ten-minute window,
        and token-request rate limits use a one-minute window. Expired
        security state is cleaned up automatically.
      </p>

      <p>
        To detect contact-email delivery problems, Resend sends signed delivery
        events to a separate Cloudflare endpoint. It checks the event and records
        only the failure category and site environment in application logs, not
        names, email addresses, message contents, or provider response bodies.
        A hashed event identifier prevents duplicate alerts for seven days and
        is removed by routine cleanup within eight days. A failure category,
        site environment, detection time, and random incident identifier remain
        until the issue is reviewed and acknowledged. This also covers immediate
        contact-email sending errors. Cloudflare retains operational logs under
        its service settings. UptimeRobot checks public site availability,
        certificate status, and a healthy/unhealthy email-failure status;
        it does not receive contact-form submissions or incident details.
      </p>

      <p>
        This does not mean that inquiry emails disappear after those
        windows. Resend retains email content and delivery records under
        its <a href="https://resend.com/security/gdpr">service retention policy</a>, and copies may remain in the receiving
        email service, mailbox, and backups. Contact Tim using the details
        below with a question or deletion request.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Data Retention -->

<!-- Data Security -->

    <section
      class="privacy-card"
      aria-labelledby="security-title">

      <h2 id="security-title">
        Data Security
      </h2>

      <p>
        Reasonable administrative and technical safeguards are used to
        protect information submitted through this website.
      </p>

      <p>
        However, no method of transmitting information over the
        Internet or storing electronic data can be guaranteed to be
        completely secure.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Data Security -->

<!-- Your Rights -->

    <section
      class="privacy-card"
      aria-labelledby="rights-title">

      <h2 id="rights-title">
        Your Rights
      </h2>

      <p>
        Depending on your location, you may have the right to:
      </p>

      <ul>
        <li>
          Request access to personal information held about you
        </li>

        <li>
          Request correction of inaccurate information
        </li>

        <li>
          Request deletion of your personal information
        </li>

        <li>
          Withdraw consent where applicable
        </li>
      </ul>

      <p>
        Requests may be submitted using the contact information
        provided below.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Your Rights -->

<!-- External Links -->

    <section
      class="privacy-card"
      aria-labelledby="external-links-title">

      <h2 id="external-links-title">
        External Links
      </h2>

      <p>
        This website contains links to external websites, including
        professional and social media platforms.
      </p>

      <p>
        Once you leave this website, those sites operate under their
        own privacy policies. We are not responsible for the privacy
        practices or content of third-party websites.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End External Links -->

<!-- Changes -->

    <section
      class="privacy-card"
      aria-labelledby="changes-title">

      <h2 id="changes-title">
        Changes to This Privacy Policy
      </h2>

      <p>
        This Privacy Policy may be updated periodically to reflect
        changes in website functionality, legal requirements, or
        privacy practices.
      </p>

      <p>
        The “Last Updated” date at the top of this page indicates when
        revisions were most recently made.
      </p>

      <p class="privacy-return-to-contents">
        <a href="#privacy-contents">
          Return to Table of Contents
        </a>
      </p>

    </section>

<!-- End Changes -->

<!-- Contact -->

    <section
      class="privacy-card privacy-contact"
      aria-labelledby="privacy-contact-title">

      <h2 id="privacy-contact-title">
        Contact
      </h2>

      <p>
        If you have questions about this Privacy Policy or wish to
        request access to or deletion of your personal information,
        please contact:
      </p>

      <address>
        <strong>Tim Gabaree</strong><br>

        <a href="mailto:tim@timgabaree.com">
          tim@timgabaree.com        </a><br>

        <a href="tel:+15717623769">
          571.762.3769        </a>
      </address>

      <p>
        You may also submit a message through the{' '}<strong><a href="/contact">contact page</a></strong>.
      </p>

    </section>

<!-- End Contact -->

<!-- Return -->

    <div class="privacy-return">

      <a
        class="primary-cta-button"
        href="/">
        Return to Main Page
      </a>

    </div>

<!-- End Return -->

  </div>

</main>
</BaseLayout>
