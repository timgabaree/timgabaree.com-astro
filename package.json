{
  "name": "timgabaree.com-astro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "site:help": "node WEBSITE-WORKFLOW/workflow.mjs help",
    "site:preview": "node WEBSITE-WORKFLOW/workflow.mjs preview",
    "site:check": "node WEBSITE-WORKFLOW/workflow.mjs check",
    "site:commit": "node WEBSITE-WORKFLOW/workflow.mjs commit",
    "site:push": "node WEBSITE-WORKFLOW/workflow.mjs push",
    "site:upload": "node WEBSITE-WORKFLOW/workflow.mjs upload",
    "site:publish": "node WEBSITE-WORKFLOW/workflow.mjs publish",
    "site:verify": "node WEBSITE-WORKFLOW/workflow.mjs verify",
    "site:login": "node WEBSITE-WORKFLOW/workflow.mjs login",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "predev": "node scripts/optimize-images.mjs",
    "prestart": "node scripts/optimize-images.mjs",
    "prebuild": "node scripts/optimize-images.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/prepare-cloudflare.mjs",
    "build:staging": "PUBLIC_SITE_ENV=staging npm run build",
    "build:production": "PUBLIC_SITE_ENV=production npm run build",
    "build:legacy-php": "astro build && node scripts/copy-php-endpoint.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787 --var ENVIRONMENT:local --var CONTACT_MODE:dry-run",
    "preview:legacy-php": "php -S 127.0.0.1:8765 -t dist scripts/preview-router.php",
    "test": "node --test tests/*.test.mjs",
    "test:monitoring": "node scripts/test-monitor-runtime.mjs",
    "test:integration": "node scripts/test-cloudflare.mjs",
    "test:staging": "node scripts/test-staging.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:live": "node scripts/test-live.mjs",
    "prepare:production": "npm run check && npm test && npm run build:production && npm run test:production && wrangler deploy --config wrangler.production.jsonc --dry-run --outdir worker-build/production",
    "deploy:staging": "npm run check && npm test && npm run build:staging && npm run test:integration && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "svix": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261027.1",
    "lightningcss": "1.33.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
