{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timgabaree-com-astro-production",
  "account_id": "7459bd2037d71d23fd030e3542b9df61",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist-production",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PRODUCTION_ENABLED": "false",
    "CONTACT_MODE": "resend"
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTACT_STATE", "class_name": "ContactState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactState"] }],
  "observability": { "enabled": false }
}
