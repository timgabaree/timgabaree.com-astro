{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timgabaree-com-astro-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  // No production routes or DNS changes. All requests pass through authentication.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "CONTACT_MODE": "resend"
  },
  "durable_objects": {
    "bindings": [{ "name": "CONTACT_STATE", "class_name": "ContactState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContactState"] }],
  "observability": { "enabled": false }
}
